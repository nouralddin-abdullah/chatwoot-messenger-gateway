# ---------- Chatwoot ----------
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_BASE_URL=

# ---------- Telegram (shared credentials) ----------
# Get these from https://my.telegram.org → API development tools.
# A single dev app can authorize many sessions, so api_id/api_hash are shared.
TG_API_ID=
TG_API_HASH=

# ---------- Telegram accounts (one block per account) ----------
# Each account needs:
#   - SESSION_NAME : a unique short name (also used as the Telethon session file name)
#   - INBOX_ID     : the Chatwoot inbox bound to this account (Channel::Api)
#   - WEBHOOK_ID   : an unguessable random token used in the Chatwoot webhook URL
#                    (generate with: python -c "import secrets; print(secrets.token_hex(32))")

TG_1_SESSION_NAME=personal
TG_1_INBOX_ID=
TG_1_WEBHOOK_ID=

# Add more accounts as needed:
# TG_2_SESSION_NAME=business
# TG_2_INBOX_ID=
# TG_2_WEBHOOK_ID=
#
# TG_3_SESSION_NAME=support
# TG_3_INBOX_ID=
# TG_3_WEBHOOK_ID=
